    "react-dom": "^18.2.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1",
    "typegpu": "^0.12.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.66",
