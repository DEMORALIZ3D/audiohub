# ==============================================================================
# AudioHub — Environment Configuration Example
# Copy this file to .env and adjust values for your server:
#   cp .env.example .env
# ==============================================================================

# Server Port & Security
PORT=4533
SECRET_KEY=change-this-to-a-secure-random-string

# Data & Music Storage Paths
DATA_DIR=./data
MUSIC_DIR=./music

# Storage Mode: "stream_only" (zero permanent disk cache) or "stream_and_cache"
STORAGE_MODE=stream_only
MAX_CACHE_GB=25.0

# Instance Branding Defaults (can also be customized in the First-Run Setup Wizard)
BRAND_NAME=AudioHub
BRAND_LOGO_URL=/icon.svg
BRAND_PRIMARY_COLOR=#10b981
BRAND_ACCENT_COLOR=#1ed760

# Optional: Timezone
TZ=UTC

# Optional: LAN Cast & DLNA Discovery
# LAN_HOST=192.168.1.100
# CAST_PRIORITY_IPS=

# Optional: Soulseek (slskd) Integration
ENABLE_SOULSEEK=false
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=

# Optional: SMTP Email for Invites & Password Resets
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
